# Database (localhost — app on host; infra only: docker compose up postgres redis minio)
# Prisma CLI (pnpm db:reset, db:migrate) loads this file from repo root — see apps/api/prisma.config.ts
DATABASE_URL=postgresql://erp:erp@localhost:5432/hospitality_erp

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=erp-files
MINIO_USE_SSL=false

# API
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# JWT authentication (change in production — min 16 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_COOKIE_NAME=erp_refresh

# Web (Next.js)
# Local dev: use web origin (3000); Next.js rewrites /api → Nest on 3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (API) — https://resend.com
# Optional. When unset, auth + notification emails are logged, not sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM=ERP <notifications@yourdomain.com>
# Dev sandbox: EMAIL_FROM=ERP <onboarding@resend.dev>

# Docker Compose api: keep localhost above for pnpm on host; compose overrides DB/Redis/MinIO
# hostnames inside the api container. JWT, CORS, NEXT_PUBLIC_* still come from here.

# Local smoke tests (pnpm smoke:local) — seeded demo user after db:reset
# SMOKE_USER_EMAIL=admin@boulevard.cafe
# SMOKE_USER_PASSWORD=DemoPassword1!
# SMOKE_FRONT_DESK_USER_EMAIL=frontdesk@boulevard.cafe
# SMOKE_FRONT_DESK_USER_PASSWORD=DemoPassword1!
# SMOKE_ORG_ID=org_00000000-0000-0000-0000-000000000100
# SMOKE_BRANCH_ID=br_00000000-0000-0000-0000-000000000001
