# Database
DATABASE_URL=postgresql://erp:erp@localhost:5432/hospitality_erp

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=erp-files
MINIO_USE_SSL=false

# API
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# PropelAuth — https://docs.propelauth.com
PROPELAUTH_AUTH_URL=https://your-project.propelauth.com
PROPELAUTH_API_KEY=your-api-key
# Optional: copy from dashboard as single line for faster cold starts
# PROPELAUTH_VERIFIER_KEY=-----BEGIN PUBLIC KEY-----\n...

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_URL=https://your-project.propelauth.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
PROPELAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Local smoke tests (pnpm smoke:local) — PropelAuth user id from dashboard → Users
# SMOKE_PROPELAUTH_USER_ID=
# SMOKE_PROPELAUTH_USER_EMAIL=you@example.com
# SMOKE_ORG_ID=org_00000000-0000-0000-0000-000000000100
# SMOKE_BRANCH_ID=br_00000000-0000-0000-0000-000000000001
