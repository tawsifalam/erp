generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  propelAuthUserId String   @unique
  email         String   @unique
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships UserOrganization[]
  joinRequests OrganizationJoinRequest[] @relation("JoinRequestUser")
  reviewedJoinRequests OrganizationJoinRequest[] @relation("JoinRequestReviewer")
  employee    Employee?
  auditLogs     AuditLog[]
  notifications Notification[]
  reportJobs    ReportJob[] @relation("ReportJobRequester")
}

model Organization {
  id           String   @id @default(uuid())
  propelAuthOrgId String   @unique
  name         String
  joinCode     String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  UserOrganization[]
  joinRequests OrganizationJoinRequest[]
  branches     Branch[]
  roomTypes    RoomType[]
  ratePlans    RatePlan[]
  guests       Guest[]
  accounts     Account[]
  vendors      Vendor[]
  employees    Employee[]
  menuCategories MenuCategory[]
  inventoryPools InventoryPool[]
  inclusionPackages InclusionPackage[]
}

model UserOrganization {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model OrganizationJoinRequest {
  id               String    @id @default(uuid())
  organizationId   String
  userId           String
  status           String    @default("PENDING")
  message          String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  assignedRole     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("JoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("JoinRequestReviewer", fields: [reviewedByUserId], references: [id])

  @@index([organizationId, status])
  @@index([userId, status])
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  timezone       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms          Room[]
  reservations   Reservation[]
  inventoryItems InventoryItem[]
  orders         Order[]
  menuCategories MenuCategory[]
  employees      Employee[]
  staffMealRecipes StaffMealRecipe[]
  staffMeals     StaffMeal[]
  reportJobs     ReportJob[]
  inclusionRecipes InclusionRecipe[]
  purchaseOrders PurchaseOrder[]
}

model RoomType {
  id             String @id @default(uuid())
  organizationId String
  name           String
  maxAdults      Int
  maxChildren    Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms        Room[]
  ratePlans    RatePlan[]
}

model RatePlan {
  id             String   @id @default(uuid())
  organizationId String
  roomTypeId     String
  name           String
  validFrom      DateTime
  validTo        DateTime
  baseModifier   Decimal  @default(1) @db.Decimal(8, 4)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roomType     RoomType     @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  rules        RateRule[]
  reservations Reservation[]

  @@index([organizationId, roomTypeId, validFrom, validTo])
}

model RateRule {
  id              String   @id @default(uuid())
  ratePlanId      String
  dayOfWeek       Int?
  minStayNights   Int?
  pricePerNight   Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([ratePlanId])
}

model Room {
  id         String     @id @default(uuid())
  branchId   String
  roomTypeId String
  roomNumber String
  status     String     @default("VACANT")
  basePrice  Decimal    @db.Decimal(12, 2)

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomType      RoomType       @relation(fields: [roomTypeId], references: [id])
  reservations  Reservation[]

  @@unique([branchId, roomNumber])
}

model Guest {
  id             String  @id @default(uuid())
  organizationId String
  fullName       String
  phone          String?
  email          String?
  createdAt      DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations  Reservation[]
}

model Reservation {
  id          String            @id @default(uuid())
  branchId    String
  guestId     String
  roomId      String
  checkIn     DateTime
  checkOut    DateTime
  status      String            @default("CONFIRMED")
  totalAmount Decimal           @db.Decimal(12, 2)
  paidAmount  Decimal           @default(0) @db.Decimal(12, 2)
  adultCount  Int               @default(1)
  childCount  Int               @default(0)
  packageId   String?
  mealsPerGuestPerNightOverride Int?
  ratePlanId  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  guest  Guest  @relation(fields: [guestId], references: [id])
  room   Room   @relation(fields: [roomId], references: [id])
  package InclusionPackage? @relation(fields: [packageId], references: [id])
  ratePlan RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  orders  Order[]
  allowances ReservationAllowance[]
  inclusionConsumptions InclusionConsumption[]

  @@index([branchId, checkIn, checkOut])
  @@index([roomId, status])
}

model MenuCategory {
  id             String @id @default(uuid())
  organizationId String
  branchId       String
  name           String
  sortOrder      Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items        MenuItem[]
}

model MenuItem {
  id         String  @id @default(uuid())
  categoryId String
  name       String
  price      Decimal @db.Decimal(12, 2)
  isActive   Boolean @default(true)
  isGuestInclusionMeal Boolean @default(false)

  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]
  recipe     Recipe?
}

model Order {
  id            String        @id @default(uuid())
  branchId      String
  status        String   @default("DRAFT")
  paymentStatus String   @default("UNPAID")
  tableNumber   String?
  notes         String?
  reservationId String?
  totalAmount   Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  reservation    Reservation?    @relation(fields: [reservationId], references: [id])
  lines          OrderLine[]
  kitchenTickets KitchenTicket[]
}

model OrderLine {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model KitchenTicket {
  id        String      @id @default(uuid())
  orderId   String
  status    String   @default("SUBMITTED")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model InventoryPool {
  id             String   @id @default(uuid())
  organizationId String
  code           String
  name           String
  isActive       Boolean  @default(true)
  isSystem       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        InventoryItem[]

  @@unique([organizationId, code])
}

model InventoryItem {
  id                String  @id @default(uuid())
  branchId          String
  poolId            String
  name              String
  sku               String
  unit              String
  lowStockThreshold Decimal? @db.Decimal(12, 4)
  averageUnitCost   Decimal  @default(0) @db.Decimal(12, 4)

  branch    Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  pool      InventoryPool       @relation(fields: [poolId], references: [id], onDelete: Restrict)
  movements InventoryMovement[]
  recipeLines RecipeLine[]
  staffMealRecipeLines StaffMealRecipeLine[]
  inclusionRecipeLines InclusionRecipeLine[]
  purchaseOrderLines   PurchaseOrderLine[]

  @@unique([branchId, sku])
}

model InventoryMovement {
  id            String            @id @default(uuid())
  itemId        String
  branchId      String
  direction     String
  movementType  String
  quantity      Decimal           @db.Decimal(12, 4)
  unitCost      Decimal?          @db.Decimal(12, 4)
  referenceType String?
  referenceId   String?
  notes         String?
  createdAt     DateTime          @default(now())

  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  goodsReceipts GoodsReceipt[]

  @@index([itemId, branchId, createdAt])
}

model Recipe {
  id         String @id @default(uuid())
  menuItemId String @unique

  menuItem MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  lines    RecipeLine[]
}

model RecipeLine {
  id              String  @id @default(uuid())
  recipeId        String
  inventoryItemId String
  quantity        Decimal @db.Decimal(12, 4)

  recipe        Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model Account {
  id             String      @id @default(uuid())
  organizationId String
  code           String
  name           String
  type           String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@unique([organizationId, code])
}

model JournalEntry {
  id             String   @id @default(uuid())
  organizationId String
  description    String?
  referenceType  String?
  referenceId    String?
  createdAt      DateTime @default(now())

  lines JournalLine[]
}

model JournalLine {
  id             String  @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(12, 2)
  credit         Decimal @default(0) @db.Decimal(12, 2)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])
}

model Employee {
  id             String  @id @default(uuid())
  organizationId String
  branchId       String?
  userId         String? @unique
  name           String
  salary         Decimal @db.Decimal(12, 2)
  designation    String
  status         String   @default("ACTIVE")
  terminatedAt   DateTime?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id])
  user         User?             @relation(fields: [userId], references: [id])
  attendance   AttendanceRecord[]
  payrollLines PayrollLine[]
  staffMeals   StaffMeal[]
}

model AttendanceRecord {
  id         String         @id @default(uuid())
  employeeId String
  branchId   String
  type       String
  recordedAt DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model PayrollRun {
  id             String           @id @default(uuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  status         String   @default("PENDING")
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  lines PayrollLine[]
}

model PayrollLine {
  id           String  @id @default(uuid())
  payrollRunId String
  employeeId   String
  grossPay     Decimal @db.Decimal(12, 2)
  deductions   Decimal @default(0) @db.Decimal(12, 2)
  netPay       Decimal @db.Decimal(12, 2)

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])
}

model StaffMealRecipe {
  id       String @id @default(uuid())
  branchId String
  name     String

  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lines        StaffMealRecipeLine[]
  consumptions StaffMeal[]

  @@unique([branchId, name])
}

model StaffMealRecipeLine {
  id              String  @id @default(uuid())
  recipeId        String
  inventoryItemId String
  quantity        Decimal @db.Decimal(12, 4)

  recipe        StaffMealRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id])
}

model StaffMeal {
  id                 String   @id @default(uuid())
  employeeId         String
  branchId           String
  staffMealRecipeId  String
  mealCount          Int
  unitCostPerMeal    Decimal  @db.Decimal(12, 2)
  deductFromPayroll  Boolean  @default(false)
  payrollDeducted    Boolean  @default(false)
  createdAt          DateTime @default(now())

  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  recipe   StaffMealRecipe @relation(fields: [staffMealRecipeId], references: [id])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Notification {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, createdAt])
  @@index([userId, readAt])
}

model ReportJob {
  id                String   @id @default(uuid())
  organizationId    String
  branchId          String?
  requestedByUserId String?
  type              String
  status            String   @default("PENDING")
  params            Json?
  fileUrl           String?
  errorMessage      String?
  createdAt         DateTime @default(now())
  completedAt       DateTime?

  branch    Branch? @relation(fields: [branchId], references: [id])
  requester User?   @relation("ReportJobRequester", fields: [requestedByUserId], references: [id])
}

model Vendor {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  contactName    String?
  email          String?
  phone          String?
  paymentTerms   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([organizationId, name])
}

model PurchaseOrder {
  id             String    @id @default(uuid())
  organizationId String
  branchId       String
  vendorId       String
  status         String    @default("DRAFT")
  expectedDate   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branch   Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  vendor   Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@index([branchId, status])
}

model PurchaseOrderLine {
  id              String  @id @default(uuid())
  purchaseOrderId String
  inventoryItemId String
  quantity        Decimal @db.Decimal(12, 4)
  unitPrice       Decimal @db.Decimal(12, 4)
  receivedQty     Decimal @default(0) @db.Decimal(12, 4)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  receipts      GoodsReceipt[]

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id                  String   @id @default(uuid())
  purchaseOrderId     String
  purchaseOrderLineId String
  inventoryMovementId String?  @unique
  quantity            Decimal  @db.Decimal(12, 4)
  receivedAt          DateTime @default(now())

  purchaseOrder     PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  inventoryMovement InventoryMovement? @relation(fields: [inventoryMovementId], references: [id], onDelete: SetNull)
}

model InclusionRecipe {
  id             String @id @default(uuid())
  branchId       String
  name           String
  inclusionType  String

  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lines        InclusionRecipeLine[]
  packageRules InclusionPackageRule[]
  allowances   ReservationAllowance[]

  @@unique([branchId, name])
}

model InclusionRecipeLine {
  id              String  @id @default(uuid())
  recipeId        String
  inventoryItemId String
  quantity        Decimal @db.Decimal(12, 4)

  recipe        InclusionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id])
}

model InclusionPackage {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules        InclusionPackageRule[]
  reservations Reservation[]

  @@unique([organizationId, name])
}

model InclusionPackageRule {
  id                       String  @id @default(uuid())
  packageId                String
  inclusionType            String
  inclusionRecipeId        String
  quantityPerGuestPerNight   Int?
  quantityPerGuestPerStay    Int?
  autoIssueOnCheckIn       Boolean @default(false)
  sortOrder                Int     @default(0)

  package InclusionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  recipe  InclusionRecipe  @relation(fields: [inclusionRecipeId], references: [id], onDelete: Restrict)
}

model ReservationAllowance {
  id                String @id @default(uuid())
  reservationId     String
  inclusionType     String
  inclusionRecipeId String
  entitledQty       Int
  consumedQty       Int    @default(0)
  unitLabel         String

  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  recipe      InclusionRecipe @relation(fields: [inclusionRecipeId], references: [id])
  consumptions InclusionConsumption[]

  @@unique([reservationId, inclusionType, inclusionRecipeId])
}

model InclusionConsumption {
  id            String   @id @default(uuid())
  reservationId String
  allowanceId   String
  branchId      String
  quantity      Int
  source        String
  referenceType String?
  referenceId   String?
  createdAt     DateTime @default(now())

  reservation Reservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  allowance   ReservationAllowance @relation(fields: [allowanceId], references: [id], onDelete: Cascade)
}
